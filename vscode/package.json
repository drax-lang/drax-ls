{
  "name": "drax-lang",
  "displayName": "Drax",
  "description": "Syntax highlighting, snippets and language configuration for the Drax language",
  "version": "0.1.0",
  "publisher": "drax-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "drax",
        "aliases": [
          "Drax",
          "drax"
        ],
        "extensions": [
          ".dx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      },
      {
        "id": "dgraph",
        "aliases": [
          "Drax Graph",
          "dgraph"
        ],
        "extensions": [
          ".dgraph"
        ],
        "icon": {
          "light": "./images/graph-icon.svg",
          "dark": "./images/graph-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "drax",
        "scopeName": "source.drax",
        "path": "./syntaxes/drax.tmLanguage.json"
      },
      {
        "language": "dgraph",
        "scopeName": "source.dgraph",
        "path": "./syntaxes/dgraph.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "drax",
        "path": "./snippets/drax.json"
      }
    ],
    "configuration": {
      "title": "Drax",
      "properties": {
        "drax.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Drax language server (go to definition, hover, completion, diagnostics)."
        }
      }
    }
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/drax-lang/drax"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:drax"
  ],
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --external:vscode --outfile=dist/extension.js && esbuild ../server/src/server.js --bundle --platform=node --outfile=dist/server.js",
    "package": "npm run build && vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "@vscode/vsce": "^3.2.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
